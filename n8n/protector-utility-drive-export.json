    {
      "parameters": {
        "jsCode": "const payload = $('Normalize Payload').item.json;\nconst existing = items.filter(i => i.json && i.json.id);\nconst content = typeof payload.data === 'string' ? payload.data : JSON.stringify(payload.data, null, 2);\nconst filePath = `${payload.folderName}/${payload.userFolderName}/${payload.fileName}`;\nconst binary = {\n  content: await this.helpers.prepareBinaryData(Buffer.from(content, 'utf8'), payload.fileName, 'application/json')\n};\nreturn [{\n  json: {\n    userFolderId: $('Set User Folder Id').item.json.userFolderId,\n    fileName: payload.fileName,\n    folderName: payload.folderName,\n    userFolderName: payload.userFolderName,\n    filePath,\n    existingFileId: existing[0]?.json?.id || null,\n    content,\n    uid: payload.uid,\n    email: payload.email\n  },\n  binary\n}];"
      },
